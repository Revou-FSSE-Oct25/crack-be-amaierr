          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "// Access the token (adjust 'access_token' based on your API's JSON structure)\r",
                  "const token = jsonData.access_token; \r",
                  "\r",
                  "// Save the token to an environment variable\r",
                  "pm.environment.set(\"my_access_token\", token);\r",
                  "\r",
                  "console.log(\"Token has been saved!\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
